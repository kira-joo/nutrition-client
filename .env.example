# Server-only — nutrition-staff's origin. Never exposed to the browser
# (no NEXT_PUBLIC_ prefix): the browser never talks to nutrition-staff
# directly, only through this app's own /api/* proxy routes. See
# docs/architecture.md ("Public data flow").
STAFF_API_BASE_URL=http://localhost:3333

# Shared secret nutrition-staff uses to authenticate calls to this app's
# /api/revalidate endpoint (Phase 5). Not used yet, declared here so the
# env contract is documented in one place as it grows.
# REVALIDATE_SECRET=
